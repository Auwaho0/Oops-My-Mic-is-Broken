# CallSaver Environment Variables
# For development and local preview, all services use internal defaults automatically.

APP_NAME=CallSaver
APP_ENV=development
API_V1_PREFIX=/api/v1

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=callsaver
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/callsaver

# Cache & Rate Limiting (Redis)
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=callsaver-sounds

# Security & Authentication
JWT_SECRET=supersecretjwtkey_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

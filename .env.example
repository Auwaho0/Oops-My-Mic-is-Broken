# ==============================================================================
# CallSaver Environment Variables Configuration
# ==============================================================================

# --- Backend Application ---
APP_NAME=CallSaver
APP_ENV=development
API_V1_PREFIX=/api/v1

# --- PostgreSQL Database ---
POSTGRES_USER=callsaver
POSTGRES_PASSWORD=callsaver
POSTGRES_DB=callsaver
DATABASE_URL=postgresql+asyncpg://callsaver:callsaver@localhost:5432/callsaver

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- S3 / MinIO Object Storage ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=callsaver-sounds

# --- Security & JWT ---
JWT_SECRET=change-this-in-production-use-a-secure-random-32-char-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (Client-side) ---
VITE_API_URL=http://localhost:8000

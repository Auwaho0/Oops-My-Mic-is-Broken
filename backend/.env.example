# Backend & Infrastructure Environment Variables (for standalone Docker/Production)
APP_NAME=CallSaver
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://callsaver:callsaver@localhost:5432/callsaver
REDIS_URL=redis://localhost:6379/0
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=callsaver-sounds
JWT_SECRET=callsaver-dev-jwt-secret-key-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000
